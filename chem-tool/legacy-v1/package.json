{
  "name": "chemistry-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Look up a chemical by name, formula or SMILES and get its 2D structure and interactive 3D model, with a REST API and MCP server for Claude Desktop, Claude Code and ChatGPT.",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node server/index.ts",
    "mcp:stdio": "node server/mcp-stdio.ts",
    "library": "node scripts/build-library.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "hono": "^4.13.5",
    "openchemlib": "^9.25.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "3dmol": "^2.5.5",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
