{
  "name": "chem-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Look up a chemical by name, formula or SMILES; see it in 2D and 3D; edit it live from Claude or ChatGPT over MCP.",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch server/index.ts",
    "build": "vite build",
    "start": "bun server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "hono": "^4.13.5",
    "openchemlib": "^9.25.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "3dmol": "^2.5.5",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
