{
  "name": "typst-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "fonts": "bun scripts/fonts.ts",
    "test": "vitest run",
    "test:server": "vitest run --project server",
    "test:ui": "vitest run --project ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "jimp": "^1.6.1",
    "lucide-react": "^1.40.0",
    "react": "^19.2",
    "react-dom": "^19.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
