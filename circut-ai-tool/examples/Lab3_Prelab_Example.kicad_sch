	(text "LAB 3 - BCD TO COMMON-ANODE 7-SEGMENT DISPLAY" (at 15.24 15.24 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "b3183e4a-74ff-4f26-bd24-48b945cd0116"))
	(text "WXYZ weights 8,4,2,1. Closed switch = 0; open = 1. Equal net labels are connected. 0 lights a segment." (at 15.24 22.86 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "c33dfee8-caf3-4852-81e7-58f1d51e8003"))
	(text "L3 header positions follow PDF top-to-bottom (not internal IC pins). Position 7 reserved. Inputs 10-15: do not care." (at 15.24 30.48 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "a3d5dcae-da07-4242-8bc1-197bb7d57242"))
	(text "e = Z + X Yn     f = Wn Xn Z + Xn Y + Y Z     g = Wn Xn Yn + X Y Z     n denotes NOT" (at 15.24 104.14 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "1ed6a35b-3b01-4fb0-bd8d-3b6bde99d6d7"))
	(text "Seven individual 330-ohm segment resistors. Display pinout shown is SA39-11EWA; check your actual display." (at 15.24 276.86 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "8af95ca9-888f-4565-8c5e-c32d613f2852"))
