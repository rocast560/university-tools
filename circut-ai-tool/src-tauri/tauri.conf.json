{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Circuit AI Tool",
  "version": "0.1.0",
  "identifier": "dev.rober.circuit-ai-tool",
  "build": { "frontendDist": "./ui" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/circuit-server"],
    "resources": ["resources/dist/**/*"],
    "windows": { "nsis": { "installMode": "currentUser" }, "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
